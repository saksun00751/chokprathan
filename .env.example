# Copy to .env.local (development) or .env.production.local (server) and fill in. Never commit real values.

# MariaDB 10.5+ connection. Percent-encode special characters in the password:
#   $ -> %24   @ -> %40   # -> %23   / -> %2F   : -> %3A   % -> %25
DATABASE_URL=mysql://user:password@db-host:3306/dbname
# Connections per app instance. Keep instances x pool size well under the server's max_connections.
DATABASE_POOL_SIZE=20
# Turn on when the MariaDB server has TLS (strongly recommended over the internet).
# DATABASE_SSL=true

# MongoDB (optional, recommended): uploaded images, dashboard and report statistics, sign-in and
# referral-click logs. Money and bills always stay in MariaDB. Without it everything uses MariaDB.
# Keep it in the same data center as the app and MariaDB. The app only uses the MONGODB_DB database.
# MONGODB_URL=mongodb+srv://user:password@cluster-host/admin?tls=true&authSource=admin
# MONGODB_DB=chokprathan

# Public address of the site (referral links, sitemap, metadata).
NEXT_PUBLIC_SITE_URL=https://example.com

# Behind the bundled nginx config, which sets X-Real-IP to the visitor's address.
TRUST_PROXY=1
# Only when Server Actions arrive through a different host name than the page (rare).
# ALLOWED_ORIGINS=www.example.com

# Background scheduler (rounds, auto results, payouts). Every instance may run it: a database
# lock makes sure only one works at a time. Set to "off" on instances that should never run it.
# SCHEDULER=off
# Migrations run when the server starts. Set to false to run "npm run db -- migrate" in your deploy step instead.
# DB_AUTO_MIGRATE=false

# SMS for phone verification (turn on "ยืนยันเบอร์ด้วย SMS" in /admin/settings afterwards).
# SMS_PROVIDER=thaibulksms
# THAIBULKSMS_API_KEY=
# THAIBULKSMS_API_SECRET=
# THAIBULKSMS_SENDER=

# Tests only: a disposable database. Every test run DROPS and rebuilds its tables.
# Production installs refuse to be wiped either way.
# TEST_DATABASE_URL=mysql://user:password@localhost:3306/lotto_test

# Game aggregator: slots, live casino, sports (AMB SuperAPI, seamless wallet). Leave empty to keep
# the games page as a preview. Staging: https://test.ambsuperapi.com
# In the AMB Back Office set the callback URL to <NEXT_PUBLIC_SITE_URL>/api/amb
# AMB_API_URL=https://test.ambsuperapi.com
# AMB_AGENT=your-agent-username
# AMB_API_KEY=your-api-key
# Required for callbacks: every bet/payout callback is checked with it (HMAC-SHA256).
# AMB_SIGNATURE_KEY=your-signature-key
# Optional: only these IPs may call the callbacks (comma separated). Recommended.
# AMB_CALLBACK_IPS=203.0.113.10,203.0.113.11
# Only if AMB sends some callbacks unsigned: accept those, and only from AMB_CALLBACK_IPS.
# AMB_ALLOW_UNSIGNED=1
# Members play as <prefix><6-digit id>. Never change it once members have played.
# AMB_USER_PREFIX=cp

